# cp .env.example 하고 채운다. .env는 커밋되지 않는다.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
CHAT_MODEL=gemini-3.1-flash-lite

# 로컬 LLM(Ollama 등)으로 돌리고 싶으면 USE_LOCAL_LLM=1만 켠다. 위 OPENAI_API_KEY는
# 안 지워도 된다 — config.py가 USE_LOCAL_LLM을 최우선으로 보고, 이 값만 지우면
# 바로 원래 게이트웨이로 롤백된다.
USE_LOCAL_LLM=
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama

# 화면 기록 API를 보호하는 Basic Auth 계정. 둘 다 없으면 서버가 기동을
# 거부한다(config.py) — 인증 없이 EC2에 떠 있던 사고 재발 방지.
SCREENLOG_USER=
SCREENLOG_PASSWORD=

# LangSmith 트레이싱. langsmith가 langchain-core의 의존성으로 이미 깔려있어서
# 이 값만 채우면 screenlog_langgraph/agent.py, graph.py의 ChatOpenAI 호출이
# 자동으로 트레이싱된다 — 코드 수정 불필요. LANGSMITH_TRACING이 비어있으면
# 트레이싱이 꺼진 채로 원래대로 동작한다.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=screenlog
