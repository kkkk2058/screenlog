# 비밀
.env

# 파이썬
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 색인 결과물 — 재생성 가능하고, 화면 기록 원문이 그대로 들어있다.
chroma/
chroma_*/

# 실험 산출물 — eval/routing/runs/의 기존 5개(vanilla·meta_filter·routed·auto)는
# 재현 불가능한 단계별 비교의 유일한 기록이라 예외로 커밋돼 있다(REPORT.md 참고).
eval/*/runs/

# macOS
.DS_Store

# 로컬 서버 실행 산출물
uvicorn.log
uvicorn.pid

# 로컬 도구 설정
.claude/
distribution/mac/menubar/.venv/
distribution/mac/menubar/build/
distribution/mac/menubar/dist/
